  -- Test: FOR ALL policy where the role holds at least one privilege should NOT be flagged
  ----------------------------------------
  create policy "all_own"
  on public.posts
  for all
  to authenticated
  using (user_id = auth.uid());
  select * from lint."0031_policy_without_privilege";
