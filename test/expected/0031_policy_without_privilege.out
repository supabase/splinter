------+-------+-------+--------+------------+-------------+--------+-------------+----------+-----------
(0 rows)

  ----------------------------------------
  -- Test: FOR ALL policy where the role holds no privilege SHOULD be flagged
  ----------------------------------------
  revoke select on public.posts from public;
  select name, detail, cache_key from lint."0031_policy_without_privilege";
           name           |                                                                                  detail                                                                                  |                   cache_key                   
--------------------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------+-----------------------------------------------
 policy_without_privilege | Table `public.posts` has RLS policy `all_own` for `ALL`, but authenticated has no SELECT, INSERT, UPDATE, or DELETE privilege on the table, so the policy has no effect. | policy_without_privilege_public_posts_all_own
(1 row)

  rollback to savepoint a;
  ----------------------------------------
  -- Test: restrictive policy should NOT be flagged
  -- Without the privilege the role is denied anyway, which is what a restrictive policy wants
  ----------------------------------------
  create policy "restrictive_insert"
  on public.posts
  as restrictive
  for insert
  to authenticated
  with check (user_id = auth.uid());
  select * from lint."0031_policy_without_privilege";
