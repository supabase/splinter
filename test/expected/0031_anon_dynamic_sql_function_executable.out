  -- NEGATIVE: no EXECUTE at all, even with a SQL-shaped parameter name
  create function public.search(query text) returns int
    language plpgsql
    security definer
    as $$
    begin
      return length(query);
    end $$;
  select * from lint."0031_anon_dynamic_sql_function_executable";
