(1 row)

  rollback to savepoint case_variadic;
  savepoint case_system_schema;
  ----------------------------------------
  -- NEGATIVE: function in a system schema is excluded
  ----------------------------------------
  create function auth.exec_sql(query text) returns void
    language plpgsql
    security definer
    as $$
