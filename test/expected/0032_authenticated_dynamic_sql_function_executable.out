  -- NEGATIVE: parameters passed to format() only in %I / %L slots
  create function public.fmt_quoted(p_table text, p_val text) returns int
    language plpgsql
    security definer
    as $$
    declare r int;
    begin
      execute format('select count(*)::int from %I where name = %L', p_table, p_val) into r;
      return r;
    end $$;
