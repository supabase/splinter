  rollback to savepoint a;
  -- NEGATIVE EXAMPLE: execute is revoked from authenticated, but RLS is
  -- disabled so the policy is never evaluated. Must not fire.
  revoke execute on function public.is_owner(uuid) from public;
  create policy docs_select on public.docs
